DATABASE_URL=mysql+pymysql://turaquant_user:CHANGE_THIS_PASSWORD@localhost:3306/turaquant_db
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PUBMED_API_KEY=
NCBI_EMAIL=
CORS_ORIGINS=https://turaquant.turacoz.com
# Public base URL of the frontend — used to build links inside emails
# (participant/team-member join links, client portal, meeting links).
# MUST be the live site, otherwise email links fall back to http://localhost:3000.
APP_PUBLIC_URL=https://turaquant.turacoz.com
UPLOAD_DIR=/var/www/turaquant/uploads

# ── LiveKit (platform default) ────────────────────────────────────────────────
# Handed straight to BROWSERS in the token response, so it must be the public
# wss:// URL. `ws://` here is refused outright by an HTTPS page as mixed content,
# and the console shows nothing LiveKit-shaped. The backend derives its own REST
# base from this same value by swapping the scheme (livekit_service.http_url).
LIVEKIT_URL=wss://livekit.turaquant.turacoz.com
LIVEKIT_API_KEY=API9e974731b257
LIVEKIT_API_SECRET=QObizA5m0lAExQr9aO6eHm_jo89l0FjFddHXEO3O2V-8ItOdQUq04A

# Deliberately EMPTY in production — live rooms stay `tq-meeting-{id}`. Local
# dev sets `dev-` so it cannot join a live board's room. Do not set this here.
LIVEKIT_ROOM_PREFIX=

# Resolved INSIDE the egress container, so `localhost` would mean egress itself.
# 172.17.0.1 is the docker bridge gateway = the host. Requires the backend to
# listen on 0.0.0.0 (see deployment/turaquant-backend.service).
EGRESS_TEMPLATE_BASE_URL=http://172.17.0.1:8000/egress-template/egress_template.html
